# Maduve Mane — Provider Portal env vars
# Copy to .env and fill in your values

# URL of the service-providers microservice (default: localhost:3003)
VITE_PROVIDERS_URL=http://localhost:3005

# URL of the bookings-service microservice (default: localhost:3004)
VITE_BOOKINGS_URL=http://localhost:3004

# URL of the auth/users service (default: localhost:3001)
VITE_AUTH_URL=http://localhost:3001
